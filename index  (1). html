            flex-direction: column;
            gap: 10px;
        }
        .option-btn {
            background: #f8f9fa;
            border: 2px solid #e9ecef;
            padding: 12px 15px;
            border-radius: 6px;
            cursor: pointer;
            text-align: left;
            font-size: 1rem;
            transition: all 0.2s;
        }
        .option-btn:hover:not([disabled]) {
            background: #e9ecef;
            border-color: var(--secondary);
        }
        .option-btn.correct {
            background-color: #d4edda !important;
            border-color: var(--success) !important;
            color: #155724;
            font-weight: bold;
        }
        .option-btn.wrong {
            background-color: #f8d7da !important;
            border-color: var(--danger) !important;
            color: #721c24;
        }
        .explanation {
            margin-top: 12px;
            padding: 10px;
            border-radius: 6px;
            font-size: 0.95rem;
            display: none;
        }
        .explanation.visible {
            display: block;
            background-color: #e8f4f8;
            border-left: 4px solid var(--secondary);
        }
        .score-board {
            position: sticky;
            top: 10px;
            background: var(--primary);
            color: white;
            padding: 15px;
            border-radius: 8px;
            text-align: center;
            font-size: 1.2rem;
            font-weight: bold;
            margin-bottom: 20px;
            z-index: 100;
        }
        .section-header {
            background: var(--secondary);
            color: white;
            padding: 10px 15px;
            border-radius: 6px;
            margin: 30px 0 15px 0;
        }
    </style>
</head>
